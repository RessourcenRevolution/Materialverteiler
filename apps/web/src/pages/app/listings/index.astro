---
import Layout from '~/layouts/Layout.astro'
import { Button, Container, Heading, Alert } from '@rr/ui/components'
import EmailVerificationWarning from '~/components/EmailVerificationWarning/EmailVerificationWarning.astro'
import { useTranslations } from '~/i18n/ui'
import ListingList from '~/components/ListingList.astro'
import BackgroundRect from '~/components/BackgroundRect.astro'
import { UserSchema } from '~/schemas/user'
import Input from '../../../../../../packages/ui/components/input/Input.astro'
import { getFutureActiveListings, getPastActiveListings } from '~/lib/listing'

export const prerender = false

const t = useTranslations()

const future = await getFutureActiveListings(Astro.locals.pb)
const past = await getPastActiveListings(Astro.locals.pb)
const listings = [...future, ...past]

const user = UserSchema.parse(Astro.locals.pb.authStore.record!)
const isNewUser = !Astro.locals.pb.authStore.record!.roles.includes('user');
---

<Layout title={t('dashboard.title')}>
  <Container size="xl" class="relative">
    {
      !isNewUser && listings.length > 0
      && <BackgroundRect variant="page" color="purple" class="h-[700px]! animate-delay-300" />
    }
    <EmailVerificationWarning class="animate-slide-in" />
    {user.verified && !isNewUser
      && <div class="flex justify-between items-center flex-wrap gap-4 mb-12 animate-slide-in">
        <Heading tag="h1" size="xl">
          {t('dashboard.title')}
        </Heading>
        <Button label={t('dashboard.new-listing')} href="/app/listings/new" />
      </div>
    }
    {
      user.verified && (
        isNewUser
          ? (
              <Container size="md">
                <Alert variant="neutral" class="animate-slide-in animate-delay-150">
                  <h2 class="text-xl font-bold mb-3">
                    {t('dashboard.user-approval.title')}
                  </h2>
                  <p>{t('dashboard.user-approval.text')}</p>
                </Alert>
              </Container>
            )
          : listings && listings.length > 0
            ? (
                <mv-search target="listing-list" url="/app/listings/search">
                  <Input id="listings-search-input" name="query" label="Was suchst du?" class="focus-within:bg-white mb-12 animate-slide-in animate-delay-150" data-mv-search="input" />
                  <div id="listing-list" class="[mv-search[loading]_&]:opacity-50">
                    <ListingList listings={listings} class="animate-slide-in animate-delay-300" />
                  </div>
                </mv-search>
              )
            : <Alert variant="neutral" spacing="md">
                <Heading tag="h2" size="md" class="mb-4">
                  {t('dashboard.no-listing.title')}
                </Heading>
                <p>
                  {t('dashboard.no-listing.text')}
                </p>
              </Alert>
      )
    }
  </Container>
</Layout>
